# =================================================================
# ENVIRONMENT CONFIGURATION GUIDE (VPS vs VERCEL)
# =================================================================
# 
# This codebase seamlessly supports two deployment modes:
# 1. CLIENT 1 (VPS): Uses persistent local disk storage (public/uploads)
# 2. CLIENT 2 (Vercel): Uses free serverless cloud storage (Cloudinary)
#
# =================================================================

# ── 1. CORE CONFIGURATION (REQUIRED FOR BOTH VPS & VERCEL) ────────
NODE_ENV=production
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate_a_random_32_char_secret_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── 2. CLOUDINARY CONFIGURATION (REQUIRED FOR VERCEL HOSTING) ────
# On Vercel, the filesystem is read-only serverless, so images must be 
# uploaded to Cloudinary (free tier has 25GB storage, no card needed).
#
# You can provide either the single CLOUDINARY_URL or the 3 individual keys:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Or alternatively as a single URL:
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ── 3. LOCAL STORAGE (FOR VPS CLIENT ONLY) ────────────────────────
# On VPS, if Cloudinary variables are NOT set, uploads automatically 
# save to public/uploads on the persistent server disk.
# LOCAL_UPLOAD_DIR=/absolute/path/to/public/uploads

# ── 4. OPTIONAL SERVICES ──────────────────────────────────────────
# Cloudflare Turnstile (Captcha protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@your-domain.com
